PORT=3000
DATABASE_URL="your_database_connection_string"
ENDPOINT_SECRET_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"
REDIS_URL="rediss://default:replace-with-upstash-token@your-redis.upstash.io:6379"
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
WEBHOOK_REQUEST_TIMEOUT_MS=10000
DELIVERY_WORKER_CONCURRENCY=5
