# ==============================================================================
# Relay Backend Environment Variables (Production & Development Reference)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Shared / Common Variables (Used across services)
# ------------------------------------------------------------------------------
# PostgreSQL connection URI (Required by API, Outbox Dispatcher, and Delivery Worker)
# Format for Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://your-db-user:your-db-password@ep-sample-123456.us-east-2.aws.neon.tech/relay?sslmode=require"

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV="production"


# ------------------------------------------------------------------------------
# 2. API Server Variables (Service: node dist/server.js)
# ------------------------------------------------------------------------------
# Port for the Express HTTP server (Defaults to 3000 if omitted)
PORT=3000

# Base64-encoded 32-byte AES-256-GCM encryption key for endpoint signing secrets (Required)
# Generate a new 32-byte key: openssl rand -base64 32
ENDPOINT_SECRET_ENCRYPTION_KEY="replace-with-a-base64-encoded-32-byte-key"

# Production frontend URL for CORS validation (e.g. your Vercel deployment domain)
FRONTEND_URL="https://your-relay-frontend.vercel.app"

# Optional: Additional comma-separated allowed CORS origins
# In development, localhost origins (e.g. http://localhost:5173) are allowed automatically
ALLOWED_ORIGINS="https://your-relay-frontend.vercel.app"


# ------------------------------------------------------------------------------
# 3. Outbox Dispatcher Variables (Service: node dist/outbox-dispatcher.js)
# ------------------------------------------------------------------------------
# Redis connection URI for BullMQ delivery queue (Required)
REDIS_URL="rediss://default:your-redis-token@your-redis-host.com:6379"

# Polling interval in milliseconds for unpublished outbox records (Default: 1000)
OUTBOX_POLL_INTERVAL_MS=1000

# Batch size of outbox events fetched per polling cycle (Default: 100)
OUTBOX_BATCH_SIZE=100


# ------------------------------------------------------------------------------
# 4. Delivery Worker Variables (Service: node dist/delivery-worker.js)
# ------------------------------------------------------------------------------
# Note: Also requires DATABASE_URL, REDIS_URL, and ENDPOINT_SECRET_ENCRYPTION_KEY

# Maximum concurrent webhook delivery jobs processed by this worker (Default: 5)
DELIVERY_WORKER_CONCURRENCY=5

# HTTP request timeout in milliseconds for target webhook deliveries (Default: 10000)
WEBHOOK_REQUEST_TIMEOUT_MS=10000
